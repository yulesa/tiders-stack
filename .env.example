# ── ClickHouse ────────────────────────────────────────────────────

CLICKHOUSE_USER=tiders_user
CLICKHOUSE_PASSWORD=tiders_password
CLICKHOUSE_DB=tiders
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_SECURE=false

# ── Ingestion ────────────────────────────────────────────────────
# Pipelines:
# Provider: rpc, sqd, or hypersync
INGESTION_PROVIDER=sqd
# BEARER_TOKEN= Used for authenticating with the hypersync (always required), sqd (optional) or rpc API.

# RPC URLs used as a tiders providers but also for fetching the chain head block number for the Polygon pipeline.
RPC_URL=https://polygon.gateway.tenderly.co


# ── DBT ─────────────────────────────────────────────────────
# Dev database name
CLICKHOUSE_DEV_DB=tiders_dev

# ── Dashboard ────────────────────────────────────────────────────
# Evidence reads datasource secrets via EVIDENCE_SOURCE__<source_name>__<option>.
# connection.yaml hardcoded values are invalid so a password is never stored in a file.
EVIDENCE_SOURCE__clickhouse__password=tiders_password

# ── Tiders-x402-Server ────────────────────────────────────────────────────
# Wallet address that receives x402 payments.
PAY_TO_ADDRESS=0x48d5917C65865A487bFA4d63Cf4EFE6d04595E67 #0xYourWalletAddressHere

# ── Cloudflare Tunnel ─────────────────────────────────────────────
TUNNEL_TOKEN=CloudflareAPIToken
